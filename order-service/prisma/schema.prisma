generator client {
  provider = "prisma-client"
  output   = "../src/prisma-client"
}

datasource db {
  provider = "postgresql"
}

enum OrderStatus {
  PENDING
  AWAITING_PAYMENT
  COMPLETED
  CANCELLED
}

model Order {
  id          String        @id @default(uuid())
  status      OrderStatus   @default(PENDING) 
  items       Item[]
  totalAmount Decimal
  currency    String
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
}


model Item {
  id        String @id @default(uuid())
  productId String
  quantity  Int
  unitPrice Decimal

  orderId   String
  order     Order  @relation(fields: [orderId], references: [id])

  @@index([orderId])
  @@index([productId])
}

model OutboxEvent {
  id          String    @id   //the eventId
  routingKey  String
  payload     Json
  createdAt   DateTime  @default(now())
  publishedAt DateTime?

  @@index([publishedAt, createdAt])
}
